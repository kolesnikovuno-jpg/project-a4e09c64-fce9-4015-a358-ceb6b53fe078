# Lovable Cloud / Supabase — auto-managed in Lovable.
# When deploying outside Lovable (e.g. Vercel), set these in the host's env settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Independent EGG ENGINE service -- server only, NOT the Lovable website DB.
# EGG_SUPABASE_URL must point to a separate Supabase project.
# Set these on test-branch Vercel server functions, not in VITE_* or frontend JS.
EGG_SUPABASE_URL=
EGG_SUPABASE_PUBLISHABLE_KEY=
EGG_SUPABASE_SERVICE_ROLE_KEY=
