{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:locale(uk|ru|en)/:legacy(lyra|lyra-request)",
      "destination": "https://lyra.kolesnikov.studio/:locale",
      "permanent": false
    },
    {
      "source": "/:legacy(lyra|lyra-request)",
      "destination": "https://lyra.kolesnikov.studio/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lyra.kolesnikov.studio"
        }
      ],
      "destination": "/og/lyra-root.html"
    },
    {
      "source": "/uk",
      "has": [
        {
          "type": "host",
          "value": "lyra.kolesnikov.studio"
        }
      ],
      "destination": "/og/lyra-uk.html"
    },
    {
      "source": "/ru",
      "has": [
        {
          "type": "host",
          "value": "lyra.kolesnikov.studio"
        }
      ],
      "destination": "/og/lyra-ru.html"
    },
    {
      "source": "/en",
      "has": [
        {
          "type": "host",
          "value": "lyra.kolesnikov.studio"
        }
      ],
      "destination": "/og/lyra-en.html"
    },
    {
      "source": "/lyra-concept",
      "destination": "/og/lyra-en-lyra-concept.html"
    },
    {
      "source": "/:path((?!og/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
