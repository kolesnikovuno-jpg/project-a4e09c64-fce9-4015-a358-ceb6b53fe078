{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/uk/lyra-request",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|TelegramBot|WhatsApp|LinkedInBot|Slackbot|Discordbot|Pinterest).*"
        }
      ],
      "destination": "/og/lyra-uk.html"
    },
    {
      "source": "/ru/lyra-request",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|TelegramBot|WhatsApp|LinkedInBot|Slackbot|Discordbot|Pinterest).*"
        }
      ],
      "destination": "/og/lyra-ru.html"
    },
    {
      "source": "/en/lyra-request",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|TelegramBot|WhatsApp|LinkedInBot|Slackbot|Discordbot|Pinterest).*"
        }
      ],
      "destination": "/og/lyra-en.html"
    },
    {
      "source": "/((?!og/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
