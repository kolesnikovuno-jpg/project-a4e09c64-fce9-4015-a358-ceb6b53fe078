{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "lyra.kolesnikov.studio"
        }
      ],
      "dest": "/og/lyra-root.html"
    },
    {
      "src": "^/uk/lyra-request/?$",
      "dest": "/og/lyra-uk-lyra-request.html"
    },
    {
      "src": "^/uk/lyra/?$",
      "dest": "/og/lyra-uk-lyra.html"
    },
    {
      "src": "^/ru/lyra-request/?$",
      "dest": "/og/lyra-ru-lyra-request.html"
    },
    {
      "src": "^/ru/lyra/?$",
      "dest": "/og/lyra-ru-lyra.html"
    },
    {
      "src": "^/en/lyra-request/?$",
      "dest": "/og/lyra-en-lyra-request.html"
    },
    {
      "src": "^/en/lyra/?$",
      "dest": "/og/lyra-en-lyra.html"
    },
    {
      "src": "^/lyra/?$",
      "dest": "/og/lyra-en-lyra.html"
    },
    {
      "src": "^/lyra-request/?$",
      "dest": "/og/lyra-en-lyra-request.html"
    },
    {
      "src": "^/lyra-concept/?$",
      "dest": "/og/lyra-en-lyra-concept.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/((?!og/|assets/|.*\\..*).*)$",
      "dest": "/index.html"
    }
  ]
}
