{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    {
      "src": "^/(uk|ru|en)/(lyra|lyra-request)/?$",
      "status": 307,
      "headers": {
        "Location": "https://lyra.kolesnikov.studio/$1"
      }
    },
    {
      "src": "^/(lyra|lyra-request)/?$",
      "status": 307,
      "headers": {
        "Location": "https://lyra.kolesnikov.studio/"
      }
    },
    {
      "src": "^/(uk|ru|en)/nava/?$",
      "status": 307,
      "headers": {
        "Location": "https://nava.kolesnikov.studio/$1"
      }
    },
    {
      "src": "^/nava/?$",
      "status": 307,
      "headers": {
        "Location": "https://nava.kolesnikov.studio/"
      }
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "nava.kolesnikov.studio"
        }
      ],
      "dest": "/og/nava-root.html"
    },
    {
      "src": "^/uk/?$",
      "has": [
        {
          "type": "host",
          "value": "nava.kolesnikov.studio"
        }
      ],
      "dest": "/og/nava-uk.html"
    },
    {
      "src": "^/ru/?$",
      "has": [
        {
          "type": "host",
          "value": "nava.kolesnikov.studio"
        }
      ],
      "dest": "/og/nava-ru.html"
    },
    {
      "src": "^/en/?$",
      "has": [
        {
          "type": "host",
          "value": "nava.kolesnikov.studio"
        }
      ],
      "dest": "/og/nava-en.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "lyra.kolesnikov.studio"
        }
      ],
      "dest": "/og/lyra-root.html"
    },
    {
      "src": "^/uk/?$",
      "has": [
        {
          "type": "host",
          "value": "lyra.kolesnikov.studio"
        }
      ],
      "dest": "/og/lyra-uk.html"
    },
    {
      "src": "^/ru/?$",
      "has": [
        {
          "type": "host",
          "value": "lyra.kolesnikov.studio"
        }
      ],
      "dest": "/og/lyra-ru.html"
    },
    {
      "src": "^/en/?$",
      "has": [
        {
          "type": "host",
          "value": "lyra.kolesnikov.studio"
        }
      ],
      "dest": "/og/lyra-en.html"
    },
    {
      "src": "^/lyra-concept/?$",
      "dest": "/og/lyra-en-lyra-concept.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!api/|og/|assets/|.*\\..*).*$",
      "dest": "/index.html"
    }
  ]
}