{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lyra.kolesnikov.studio"
        }
      ],
      "destination": "/og/lyra-root.html"
    },
    {
      "source": "/uk/lyra-request",
      "destination": "/og/lyra-uk-lyra-request.html"
    },
    {
      "source": "/uk/lyra",
      "destination": "/og/lyra-uk-lyra.html"
    },
    {
      "source": "/ru/lyra-request",
      "destination": "/og/lyra-ru-lyra-request.html"
    },
    {
      "source": "/ru/lyra",
      "destination": "/og/lyra-ru-lyra.html"
    },
    {
      "source": "/en/lyra-request",
      "destination": "/og/lyra-en-lyra-request.html"
    },
    {
      "source": "/en/lyra",
      "destination": "/og/lyra-en-lyra.html"
    },
    {
      "source": "/lyra",
      "destination": "/og/lyra-en-lyra.html"
    },
    {
      "source": "/lyra-request",
      "destination": "/og/lyra-en-lyra-request.html"
    },
    {
      "source": "/lyra-concept",
      "destination": "/og/lyra-en-lyra-concept.html"
    },
    {
      "source": "/((?!og/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
